# ============================================================
# 配置模板（可以安全地给别人看、拷到别的电脑）
# 用法：复制一份改名为 .env，然后把下面每一项填上你自己的值。
# 注意：.env 里会有密码，**不要**发给别人、不要传到网上。
# ============================================================

# ---------- 基本身份 ----------
APP_NAME=轻量级课设版数据可视化平台
APP_ENV=development

# ---------- 后端监听地址 ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---------- 允许访问后端的前端地址 ----------
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 数据库选择 ----------
# sqlite = 本地兜底库（开发/断网演示用，推荐先这样）
# mssql  = 学校发的 SQL Server
DB_MODE=sqlite
SQLITE_PATH=data/app.db

# ---------- 学校 SQL Server（DB_MODE=mssql 时才需要填）----------
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# ---------- 登录令牌签名密钥（第 3 阶段用）----------
# 留空的话由脚本自动生成一个随机值，不要手写简单密码
SECRET_KEY=
# ---------- 内置演示账号（密码留空时启动会自动随机生成并写回 .env）----------
DEMO_USERNAME=demo
DEMO_PASSWORD=
# ---------- 上传限制 ----------
MAX_UPLOAD_MB=5
MAX_ROWS=5000
MAX_COLUMNS=50
